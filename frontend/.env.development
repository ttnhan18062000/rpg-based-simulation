# Dev-only API key, matched to the fixed dev hash the Makefile's `dev` target passes to the
# backend (`make dev` -> `--api-key-hashes "dev:<sha256 of this raw key>"`). Not a real secret --
# local dev only, never used by a production deployment. See
# docs/architecture/http_api_key_authentication.md and TCK-20260825-LIVE-MAP-DEV-AUTH-AND-WS-PROXY-FIX.
VITE_API_KEY=dev-local-key-do-not-use-in-prod
