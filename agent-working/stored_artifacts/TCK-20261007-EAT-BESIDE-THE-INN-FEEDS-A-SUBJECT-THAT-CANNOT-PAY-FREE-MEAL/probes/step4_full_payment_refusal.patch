+# What a service costs the subject up front: it is refused unless the subject holds the full price (nothing is free, no clamped charge).
+SERVICE_PRICES = {"REST": REST_PRICE_GOLD, "EAT": EAT_PRICE_GOLD}
+
+
+def can_pay_for(entity: Any, action: str) -> bool:
+    """True when the subject holds the full price of the service for `action` (a service with no price is always affordable)."""
+    return entity.inventory.gold >= SERVICE_PRICES.get(action, 0)
