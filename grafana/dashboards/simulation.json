{
  "title": "Simulation UI & Metrics",
  "uid": "sim-main",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "timeseries",
      "title": "Active Entities",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7},
      "targets": [{"expr": "sim_active_entities"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 10, "lineWidth": 2}}}
    },
    {
      "type": "stat",
      "title": "Current Tick",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 7},
      "targets": [{"expr": "sim_current_tick"}],
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "type": "stat",
      "title": "Ticks Per Second",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 7},
      "targets": [{"expr": "sim_ticks_per_second"}],
      "options": {"colorMode": "value", "graphMode": "area"}
    },
    {
      "type": "timeseries",
      "title": "Tick Duration (seconds)",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "targets": [
        {"expr": "rate(sim_tick_duration_seconds_sum[1m]) / rate(sim_tick_duration_seconds_count[1m])", "legendFormat": "{{phase}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Spawns vs Deaths (Rate/m)",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7},
      "targets": [
        {"expr": "rate(sim_total_spawns[1m]) * 60", "legendFormat": "Spawns"},
        {"expr": "rate(sim_total_deaths[1m]) * 60", "legendFormat": "Deaths"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Process Resource Usage",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7},
      "targets": [
        {"expr": "process_cpu_percent", "legendFormat": "CPU %"},
        {"expr": "process_memory_rss_bytes", "legendFormat": "RSS Bytes"}
      ],
      "fieldConfig": {"defaults": {"custom": {"axisPlacement": "left"}}}
    },
    {
      "type": "timeseries",
      "title": "Event Rates (per minute)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7},
      "targets": [
        {"expr": "rate(sim_combat_events_total[1m]) * 60", "legendFormat": "Combat"},
        {"expr": "rate(sim_skill_events_total[1m]) * 60", "legendFormat": "Skill"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Action Queue Depth",
      "gridPos": {"x": 0, "y": 21, "w": 24, "h": 6},
      "targets": [{"expr": "sim_action_queue_depth"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"fillOpacity": 15}}}
    }
  ]
}
